pipeline {
    agent { label 'docker-agent' }

    parameters {
        string(name: 'VM_IP',      defaultValue: '0.0.0.0',              description: 'Adresse IP de la VM frontend')
        string(name: 'VM_USER',    defaultValue: 'ubuntu',               description: 'Utilisateur SSH')
        string(name: 'PORT',       defaultValue: '80',                   description: 'Port sur lequel sera exposé le frontend')
        string(name: 'API_URL',    defaultValue: 'http://0.0.0.0:3001',  description: 'URL de l\'API backend (ex: http://192.168.1.10:3001)')
        string(name: 'IMAGE_TAG',  defaultValue: 'latest',               description: 'Tag de l\'image à déployer — "latest" correspond à la version la plus récente, indiquer un numéro de build pour rollback (ex. 7)')
    }

    environment {
        IMAGE_NAME     = 'frontend-crisisview'
        CONTAINER_NAME = 'frontend-crisisview'
    }

    stages {

        stage('Deploy') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sshagent(['vm-ssh-key-front']) {
                        sh "ssh -o StrictHostKeyChecking=no ${params.VM_USER}@${params.VM_IP} 'docker pull ${DOCKERHUB_USER}/${IMAGE_NAME}:${params.IMAGE_TAG}; docker rm -f ${CONTAINER_NAME} || true; docker run -d --name ${CONTAINER_NAME} -p ${params.PORT}:3000 -e API_URL=${params.API_URL} ${DOCKERHUB_USER}/${IMAGE_NAME}:${params.IMAGE_TAG}'"
                    }
                }
            }
        }

    }

    post {
        success {
            echo "Frontend déployé sur ${params.VM_IP}:${params.PORT} (tag: ${params.IMAGE_TAG})"
        }
        failure {
            echo 'Le déploiement a échoué — vérifier les logs ci-dessus.'
        }
    }
}
